# Copy these values into the repository-root .env file.
# Supported provider types: openai-compatible, openai-responses, gemini, ollama.
# API keys are read only through credential references; Ollama keys may be blank.

# Enables the same real four-role runtime in projects_web_demo.py.
OXYGENT_ENABLE_REAL_WORKFLOW=1

OXYGENT_PM_PROVIDER_TYPE=openai-compatible
OXYGENT_PM_BASE_URL=https://api.example.com/v1
OXYGENT_PM_API_KEY=replace_me
OXYGENT_PM_MODEL=pm-model
OXYGENT_PM_TIMEOUT=120

OXYGENT_ARCHITECT_PROVIDER_TYPE=gemini
OXYGENT_ARCHITECT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OXYGENT_ARCHITECT_API_KEY=replace_me
OXYGENT_ARCHITECT_MODEL=architect-model
OXYGENT_ARCHITECT_TIMEOUT=120

OXYGENT_LEAD_PROVIDER_TYPE=ollama
OXYGENT_LEAD_BASE_URL=http://127.0.0.1:11434
OXYGENT_LEAD_API_KEY=
OXYGENT_LEAD_MODEL=lead-model
OXYGENT_LEAD_TIMEOUT=120

OXYGENT_REVIEWER_PROVIDER_TYPE=openai-compatible
OXYGENT_REVIEWER_BASE_URL=https://another-api.example.com/v1
OXYGENT_REVIEWER_API_KEY=replace_me
OXYGENT_REVIEWER_MODEL=reviewer-model
OXYGENT_REVIEWER_TIMEOUT=120
# Keep enabled for an independent Reviewer Provider. Set to 0 only when all
# configured models must share one Provider endpoint.
OXYGENT_REVIEWER_EXCLUDE_PRODUCER_PROVIDER=1

OXYGENT_PLATFORM_IDEA=Describe the product idea to process through four roles.

# Aider uses a longer bounded timeout than short planning calls because a
# multi-file coding response can take several minutes. "low" keeps GPT-style
# reasoning models responsive; change to medium/high only for difficult tasks.
OXYGENT_AIDER_PROVIDER_TIMEOUT_SECONDS=300
OXYGENT_AIDER_TIMEOUT_SECONDS=420
OXYGENT_AIDER_REASONING_EFFORT=low
